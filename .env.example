# ─────────────────────────────────────────────────────────────────────────
#  Print Agent — contoh konfigurasi
#
#  Cara pakai:  copy file ini jadi ".env"  (di folder yang sama dengan
#  package.json saat dev, atau %APPDATA%\print-agent\.env saat ter-install),
#  lalu ubah nilainya. Agent membaca .env saat start.
#
#  Nilai di sini menang atas setting tersimpan (electron-store) dan default
#  bawaan. Baris yang di-comment (#) → pakai default.
#
#  Env var OS yang sudah di-set TIDAK ditimpa oleh file ini — jadi bisa
#  override sekali jalan lewat:  PRINT_AGENT_PORT=9200 npm start
# ─────────────────────────────────────────────────────────────────────────

# Port HTTP server loopback. Server hanya listen di 127.0.0.1.
# Default: 9110
PRINT_AGENT_PORT=9110

# Nama printer PERSIS seperti keluaran PowerShell `Get-Printer`
# (mis. "ZDesigner ZD220-203dpi ZPL"). Dipakai kalau request POST /print
# tidak menyertakan field "printer".
#
# TIDAK WAJIB diisi — printer bisa dipilih lewat menu tray
# "Pengaturan Printer..." (disimpan ke electron-store). Agent TIDAK pernah
# jatuh ke default printer Windows: kalau tidak ada yang dipilih dan request
# tidak mengirim "printer", job ditolak (printer_not_found).
#
# CATATAN: kalau baris ini di-set, nilainya menang tiap agent start dan
# menimpa pilihan dari menu Settings. Biarkan di-comment kalau mau memakai
# menu Settings sebagai sumber pilihan.
# Default: (kosong)
#PRINT_AGENT_DEFAULT_PRINTER=ZDesigner ZD220-203dpi ZPL

# Origin yang boleh memanggil server (CORS). Pisah dengan koma.
# "*" = izinkan semua (aman untuk loopback tanpa data sensitif).
# Perketat ke domain dsmart kalau mau:
#   PRINT_AGENT_ALLOWED_ORIGINS=https://app.dsmart.co,http://localhost:3000
# Default: *
PRINT_AGENT_ALLOWED_ORIGINS=*

# dry-run: true → ZPL ditulis ke file temp, TIDAK dikirim ke printer.
# Berguna saat dev di mesin tanpa printer. Di non-Windows selalu efektif
# dry-run (adapter yang aktif = Mock).
# Default: false
PRINT_AGENT_DRY_RUN=false

# ── BrowserWindow opsional untuk dsmart (§3.8) ───────────────────────────
# "Chrome terkurung" — window Electron yang me-load dsmart. Tetap fetch ke
# port di atas, TANPA preload/IPC. Aktifkan hanya untuk PC kiosk.

# true → buka window dsmart saat agent start.
# Default: false
PRINT_AGENT_EMBEDDED_BROWSER=false

# URL yang dimuat window itu. WAJIB diisi kalau PRINT_AGENT_EMBEDDED_BROWSER=true.
#PRINT_AGENT_EMBEDDED_BROWSER_URL=https://app.dsmart.co/warehouse/intake

# true → window fullscreen kiosk (tanpa frame, tanpa menu).
# Default: false
PRINT_AGENT_EMBEDDED_BROWSER_KIOSK=false
