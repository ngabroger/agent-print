<!DOCTYPE html>
<html>
<head><meta charset="utf-8"><title>Login</title></head>
<body style="font-family: sans-serif; padding: 24px;">
  <h3>SnapSnap Print Agent</h3>
  <input id="email" type="email" placeholder="Email admin" style="width:100%;padding:8px;margin-bottom:8px;box-sizing:border-box;" />
  <input id="password" type="password" placeholder="Password" style="width:100%;padding:8px;margin-bottom:8px;box-sizing:border-box;" />
  <button id="loginBtn" style="width:100%;padding:8px;">Login</button>
  <p id="error" style="color:red;font-size:13px;"></p>
  <script src="login.js"></script>
</body>
</html>